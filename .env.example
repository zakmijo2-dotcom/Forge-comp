# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Local FFmpeg API Bridge Server Configuration (server.ts)
# PORT: Port for the local Express FFmpeg bridge server (default: 3001)
PORT=3001

# BRIDGE_API_KEY: Optional Bearer token required by the bridge when set
BRIDGE_API_KEY=""

# MAX_UPLOAD_SIZE: Maximum upload size in bytes for /api/convert (default: 524288000 = 500MB)
MAX_UPLOAD_SIZE=524288000

# FFMPEG_PATH: Path or binary name for system FFmpeg executable (default: "ffmpeg")
FFMPEG_PATH="ffmpeg"
